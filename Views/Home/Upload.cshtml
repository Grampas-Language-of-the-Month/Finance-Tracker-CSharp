@using finance_tracker.Models
@model List<Transaction>

@{
    ViewData["Title"] = "Upload Bank Statement";
}
<div class="text-center">
    <h1>@ViewData["Title"]</h1>
    <p>
        This is where the user will be able to upload a CSV version of a bank statement.
        Indication will be given of upload success or failure.
    </p>

    <h2>Upload Transactions</h2>

    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="mb-4">
        <div class="input-group">
            <input type="file" name="file" class="form-control" id="inputFile"/>
            <button type="submit" class="btn btn-primary">Upload</button>
        </div>
    </form>

    @if (Model != null && Model.Count > 0)
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <h3>Summary by Category</h3>
                <div class="card-group">
                    @foreach (var group in Model.GroupBy(t => t.Category))
                    {
                        <div class="card bg-secondary text-white m-1">
                            <div class="card-body text-center">
                                <h5 class="card-title">@group.Key</h5>
                                <p class="card-text fs-4">
                                    @group.Sum(t => t.Amount).ToString("C")
                                </p>
                                <small>@group.Count() transactions</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
