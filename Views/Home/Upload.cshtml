@using finance_tracker.Models
@model List<Transaction>

@{
    ViewData["Title"] = "Upload Bank Statement";
}
<div class="text-center">
    <h1>@ViewData["Title"]</h1>
    <p>
        This is where the user will be able to upload a CSV version of a bank statement.
        Indication will be given of upload success or failure.
    </p>

    <h2>Upload Transactions</h2>

    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="mb-4">
        <div class="input-group">
            <input type="file" name="file" class="form-control" id="inputFile"/>
            <button type="submit" class="btn btn-primary">Upload</button>
        </div>
    </form>

    @if (Model != null)
    {
        @if (Model.Count > 0)
        {
            <div class="alert alert-success">
                <strong>Success!</strong> Successfully added @Model.Count new transactions to the database.
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-dark table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.TransactionDate.ToString("dd MMM yyyy")</td>
                                <td>@item.Description</td>
                                <td class="@(item.Amount < 0 ? "text-danger" : "text-success")">
                                    @item.Amount.ToString("C")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                No new transactions were added. All items in the file already exist in the database.
            </div>
        }
    }
</div>
