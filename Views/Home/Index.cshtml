@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to my financial tracker app</h1>
    <p>Now my wife and I can now automatically track our finances and how much we spend.
        To upload more data, please upload a CSV version of a bank statement in the "Upload" tab. 
        To generate a report, please use the "Reports" tab where you can specify a time period
        as well as get details on specific expenses.
    </p>
</div>
